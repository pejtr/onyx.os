# Generate three independent random secrets (recommended: 48+ random bytes).
ONYX_OPEN_LOVABLE_TOKEN=replace-with-a-random-token-at-least-32-characters
ONYX_MOTION_ANYTHING_TOKEN=replace-with-a-different-random-token-at-least-32-characters
ONYX_HTML_VIDEO_TOKEN=replace-with-a-third-random-token-at-least-32-characters

# Open Lovable
FIRECRAWL_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
